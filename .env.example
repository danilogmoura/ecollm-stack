# ============================================================================
# Copie para .env e preencha:   cp .env.example .env
# NUNCA versione o .env real (esta em .gitignore). O docker-compose.yml le TODAS
# as variaveis daqui via ${VAR:-default}. Os DEFAULTS abaixo sao credenciais de
# DEV LOCAL (stack single-user, bind loopback apenas) — troque-os antes de expor
# a stack ou usar com dados reais. Ver tambem S17 (rotacao da master key).
# ============================================================================

# --- chaves de provedor upstream (obrigatorio preencher) ---
# Google AI Studio (embeddings rag-embeddings = gemini-embedding-2):
GEMINI_API_KEY=coloque-sua-chave-aqui
# Token Plan Individual (QwenCloud) — chave comeca com sk-sp-
# Console: https://www.qwencloud.com/pricing/token-plan
QWEN_PLAN_API_KEY=coloque-sua-chave-sk-sp-aqui

# --- LiteLLM proxy (:4000) ---
# Chave-mestra que autentica clientes no proxy. Gere uma sua e NUNCA reutilize
# um valor de exemplo:  openssl rand -hex 24 | sed 's/^/sk-/'   (S17 rotacionou a
# chave real; este arquivo só traz placeholder, nunca um segredo válido).
LITELLM_MASTER_KEY=defina-uma-chave-forte-aqui

# --- nível de log do proxy LiteLLM (S28 / T-OPS-5) ---
# Default INFO. NAO use DEBUG em produção: com LITELLM_LOG=DEBUG (+ set_verbose)
# o proxy despeja o CORPO INTEIRO de cada request nos logs — incluindo a master
# key e todo o payload do agente. Só para depuração pontual, assumindo o risco:
#   LITELLM_LOG=DEBUG docker compose up -d litellm
LITELLM_LOG=INFO

# --- litellm-db (postgres interno do proxy, p/ SpendLogs) ---
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=litellm_secret
LITELLM_DB_NAME=litellm

# --- rag-db (pgvector) ---
RAG_DB_USER=rag
RAG_DB_PASSWORD=rag_secret
RAG_DB_NAME=rag
# URL vista PELO CONTAINER litellm (rede interna, host = nome do servico):
RAG_DB_URL_INTERNAL=postgresql://rag:rag_secret@rag-db:5432/rag
# URL vista PELO CLI de ingest no HOST (bind loopback 127.0.0.1:5433):
RAG_DB_URL=postgresql://rag:rag_secret@localhost:5433/rag

# --- cliente Python (ingest/, eval/, mcp/) ---
LITELLM_BASE_URL=http://localhost:4000
RAG_EMBED_MODEL=rag-embeddings
