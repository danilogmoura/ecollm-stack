# Segredos da stack — nunca versionar
.env

# Planejamento, análise de bugs e resolução — exclusivo local, nunca sobe
.planning/
# Relatórios/logs de diagnóstico dos provedores LLM. Política S106 (2026-10-16):
# reports/ é VERSIONADO — relatórios e logs do trilho NovAI são públicos. Ficam
# locais apenas os 4 artefatos de telemetria operacional abaixo (contêm queries
# reais de RAG e histórico de custo da conta). Nada de segredo aqui: URLs
# pré-assinadas de saída de imagem são redigidas por `eval/novai_enrich.py`.
/reports/logs/mcp-stderr.log
/reports/logs/mcp-stderr.log.1
/reports/logs/h4-mcp-stderr.log
/reports/logs/rag-sync.log
/reports/logs/rag-sync.log.1
/reports/logs/c6-cost-history.json
# S103 / Fase G (2026-10-17): logs brutos de mídia. As respostas de geração de
# imagem trazem URL PRÉ-ASSINADA (OSS/COS) com AccessKeyId/SecretId de terceiros
# na query; o GitHub Push Protection bloqueia o push (GH013) mesmo com a redação
# aplicada em `redact_signed_urls` (o regex não cobre 100% das variantes). Estes
# ficam locais; o relatório versionado cita só host+path.
/reports/logs/*-novai-image.jsonl
/reports/logs/*-novai-both.jsonl
/reports/logs/*-novai-gateway.jsonl
/reports/logs/*.contaminated.jsonl
# Docs/narrativas locais (diagnóstico, runbooks, explicações) — local-only, nunca sobe
/docs/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Cobertura (pytest-cov) — artefato local
.coverage
htmlcov/
cov_html/
